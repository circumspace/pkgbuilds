# Maintainer: hermeticvm <215889057+hermeticvm@users.noreply.github.com>
# Upstream: https://github.com/khaosdoctor/proton-drive-linux-fs

pkgname=proton-drive-fs
pkgver=0.29.0
pkgrel=1
pkgdesc='FUSE virtual filesystem for Proton Drive on Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/khaosdoctor/proton-drive-linux-fs'
license=('MIT')
depends=('fuse3' 'libsecret' 'gtk3' 'zenity')
makedepends=('go' 'git')
optdepends=('zenity: About dialog'
            'libsecret: store the key password in the OS keyring')
conflicts=('proton-drive-fs-bin')
provides=('proton-drive-fs')

source=("https://github.com/khaosdoctor/proton-drive-linux-fs/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('de9f8f3869210ba0559065505c834a956fa1bb269fb0ebf870b07411f83f0a5d')

prepare() {
  cd "${srcdir}/proton-drive-linux-fs-${pkgver}"
  # Generate version string matching upstream's git describe
  echo -n "${pkgver}" > .version
}

build() {
  cd "${srcdir}/proton-drive-linux-fs-${pkgver}"

  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  # Build the main binary
  go build -ldflags "-s -w -X main.version=${pkgver} -X main.commit=${pkgver}" \
    -o proton-drive-fs ./cmd/proton-drive-fs

  # Generate systemd unit from template
  mkdir -p systemd
  sed 's|@BINDIR@|/usr/bin|g' \
    cmd/proton-drive-fs/proton-drive-fs.service \
    > systemd/proton-drive-fs.service
}

package() {
  cd "${srcdir}/proton-drive-linux-fs-${pkgver}"

  # Binary
  install -Dm755 "./proton-drive-fs" "${pkgdir}/usr/bin/proton-drive-fs"

  # License
  install -Dm644 "./LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Desktop file
  install -Dm644 "./contrib/proton-drive-fs.desktop" \
    "${pkgdir}/usr/share/applications/proton-drive-fs.desktop"

  # Icon
  install -Dm644 "./contrib/icons/proton-drive-fs.png" \
    "${pkgdir}/usr/share/icons/hicolor/64x64/apps/proton-drive-fs.png"

  # Systemd user unit
  install -Dm644 "./systemd/proton-drive-fs.service" \
    "${pkgdir}/usr/lib/systemd/user/proton-drive-fs.service"

  # AppStream metadata
  install -Dm644 "./contrib/io.github.khaosdoctor.proton_drive_fs.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.khaosdoctor.proton_drive_fs.metainfo.xml"

  # Arch Linux packaging hooks/scripts
  install -Dm644 "./contrib/packaging/proton-drive-fs-upgrade.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/proton-drive-fs-upgrade.hook"
  install -Dm755 "./contrib/packaging/proton-drive-fs-restart" \
    "${pkgdir}/usr/share/libalpm/scripts/proton-drive-fs-restart"
}
