# Maintainer: hermeticvm <215889057+hermeticvm@users.noreply.github.com>
# Contributor: Lucas Santos <hello@lsantos.dev>

pkgname=proton-drive-fs
pkgver=0.29.0
pkgrel=1
pkgdesc='FUSE virtual filesystem for Proton Drive on Linux. Mount your drive as a local folder with on-demand file download.'
arch=('x86_64' 'aarch64')
url='https://github.com/khaosdoctor/proton-drive-linux-fs'
license=('MIT')
depends=('fuse3' 'glibc')
optdepends=('zenity: About dialog'
            'libsecret: store the key password in the OS keyring')
makedepends=('go' 'git')
conflicts=('proton-drive-fs-bin')

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/khaosdoctor/proton-drive-linux-fs/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('de9f8f3869210ba0559065505c834a956fa1bb269fb0ebf870b07411f83f0a5d')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  go mod download
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=v${pkgver} -X main.commit=v${pkgver}" \
    -o "${pkgname}" ./cmd/proton-drive-fs
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "./${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "./LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "./contrib/proton-drive-fs.desktop" \
    "${pkgdir}/usr/share/applications/proton-drive-fs.desktop"
  install -Dm644 "./contrib/icons/proton-drive-fs.png" \
    "${pkgdir}/usr/share/icons/hicolor/64x64/apps/proton-drive-fs.png"

  # Systemd user service (bindir substituted to /usr/bin)
  sed 's|@BINDIR@|/usr/bin|g' "./cmd/proton-drive-fs/proton-drive-fs.service" \
    > "${srcdir}/proton-drive-fs.service"
  install -Dm644 "${srcdir}/proton-drive-fs.service" \
    "${pkgdir}/usr/lib/systemd/user/proton-drive-fs.service"

  install -Dm644 "./contrib/io.github.khaosdoctor.proton_drive_fs.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.khaosdoctor.proton_drive_fs.metainfo.xml"
}
